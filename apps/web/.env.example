# Copier vers .env.local. Next.js lit ce dossier (apps/web), pas la racine.
# Clé anon / publishable uniquement — jamais la service_role.
# NEXT_PUBLIC_* est intégré au build : changer l'URL exige un rebuild.
# Projet cloud TAXI-NA-BISO (Settings → API) : https://yfrvppolwkyuzqvbbrai.supabase.co
# Ne laissez jamais YOUR_PROJECT ni http://127.0.0.1:54321 dans un build de démo/prod.

NEXT_PUBLIC_SUPABASE_URL=https://yfrvppolwkyuzqvbbrai.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Origine du site (métadonnées Open Graph).
# Dev :
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3001
# Production :
# NEXT_PUBLIC_SITE_URL=https://taxinabiso.newsystemcorps.com
# NEXT_PUBLIC_WEB_URL=https://taxinabiso.newsystemcorps.com

# development | staging | production
# staging affiche le bouton « compte de démonstration ». production ne l’affiche pas.
NEXT_PUBLIC_APP_ENV=development

# Style MapLibre (optionnel, URL publique). Sans valeur, la carte utilise CARTO/OSM (pas de clé secrète).
NEXT_PUBLIC_MAP_STYLE_URL=

# Liens vers les apps natives (PWA / bandeau chauffeur).
NEXT_PUBLIC_DRIVER_APP_URL=
NEXT_PUBLIC_RIDER_APP_URL=
NEXT_PUBLIC_SUPPORT_PHONE=+243800000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=243800000000
