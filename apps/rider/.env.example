# Copier vers .env.local. Expo injecte les variables EXPO_PUBLIC_* dans le bundle.
# Ne jamais y mettre la clé service_role — uniquement l’URL et la clé anon/publishable.
#
# Projet hébergé TAXI-NA-BISO :
#   Supabase Dashboard → Project Settings → API
#   → Project URL + anon / publishable key
#
# Backend local (optionnel) :
#   iOS simulateur : http://127.0.0.1:54321
#   émulateur Android : http://10.0.2.2:54321
#   appareil physique (Expo Go) : http://<IP-LAN>:54321
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Recherche d’adresses — clé gratuite : https://cloud.maptiler.com/account/keys/
# Sans cette clé, Rider propose les lieux de démonstration Kinshasa.
EXPO_PUBLIC_MAPTILER_KEY=

# Restreint les numéros acceptés côté client (liste interne). N’affiche rien.
# false par défaut. Ne contient aucun secret. L’OTP reste vérifié par Supabase.
EXPO_PUBLIC_DEMO_MODE=false

# TEMPORAIRE — auth locale Rider (5 numéros + 123456). Inerte si __DEV__ est false.
# Toujours false en production. Voir docs/REMOVE_HARDCODED_DEMO_AUTH.md.
EXPO_PUBLIC_DEMO_AUTH_ENABLED=false
