# Copy to .env.local and fill in. Next.js reads env files from this directory
# (apps/admin), NOT the repo root — that is why these live here.
#
# For local dev, the default Supabase CLI values are:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `pnpm db:status`>
#
# The anon key is public by design (RLS protects the data).
# Never put SUPABASE_SERVICE_ROLE_KEY in this app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev :
NEXT_PUBLIC_WEB_URL=http://localhost:3001
# Production :
# NEXT_PUBLIC_WEB_URL=https://taxinabiso.newsystemcorps.com

# development | staging | production
NEXT_PUBLIC_APP_ENV=development
