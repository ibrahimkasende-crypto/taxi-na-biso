{
  "expo": {
    "name": "Taxi Na Biso Chauffeur",
    "slug": "taxi-na-biso-driver",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/driver-icon.png",
    "scheme": "taxinabiso-driver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/driver-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.taxinabiso.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Taxi Na Biso utilise votre position pour recevoir des courses et indiquer votre arrivée.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "La position en arrière-plan est utilisée pendant une course pour que le passager puisse vous suivre.",
        "UIBackgroundModes": ["location", "fetch"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/driver-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "cd.taxinabiso.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-location", "expo-secure-store"],
    "extra": {}
  }
}
